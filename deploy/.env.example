# --- Content Factory: шаблон конфигурации ---
# Скопируйте в .env и заполните своими значениями.

# JWT-подпись (обязательно смените!)
CF_SECRET_KEY=please-change-me-to-a-long-random-string

# Мастер-ключ Fernet для шифрования API-ключей заказчика.
# Можно оставить пустым — будет выведен из CF_SECRET_KEY.
# Сгенерировать:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CF_FERNET_KEY=

# Администратор первого запуска (потом можно зарегистрироваться в панели)
CF_ADMIN_USERNAME=admin
CF_ADMIN_PASSWORD=admin123

# Лицензирование. Публичный ключ продавца (см. tools/keygen) — опционально для демо.
# CF_LICENSE_PUBKEY=
# CF_LICENSE_REQUIRED=false
# CF_DEMO_MODE=true

# Reseller (Unlimited): приватный ключ для выпуска лицензий прямо из панели.
# PEM-ключ, который создаёт tools/keygen (private.pem) — вставьте содержимое одной строкой.
# CF_RESELLER_PRIVATE_KEY=

# CORS (для разработки фронта на отдельном порту). В проде — пусто.
CF_CORS_ORIGINS=*
